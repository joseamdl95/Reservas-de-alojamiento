{% extends "base.html.twig" %}

{% block title %}Listado de Reservas{% endblock %}

{% block content %}
    <h2>Reservas</h2>

    <button type="button" id="btn-nueva">+ Nueva reserva</button>

    <div id="form-crear" style="display: none;">
        <h3>Nueva reserva</h3>
        {% include 'partials/form_reserva.html.twig' %}
    </div>

    <form id="form-filtros">
        <label>
            Huésped:
            <input type="text" name="nombre_huesped" placeholder="Nombre...">
        </label>

        <label>
            Alojamiento:
            <input type="text" name="nombre_alojamiento" placeholder="Alojamiento...">
        </label>

        <label>
            Estado:
            <select name="estado">
                <option value="">Todos</option>
                <option value="pendiente">Pendiente</option>
                <option value="confirmada">Confirmada</option>
                <option value="cancelada">Cancelada</option>
            </select>
        </label>

        <label>
            Entrada desde:
            <input type="date" name="fecha_desde">
        </label>

        <label>
            Salida hasta:
            <input type="date" name="fecha_hasta">
        </label>

        <button type="submit">Filtrar</button>
        <button type="button" id="btn-limpiar">Limpiar</button>
    </form>

    <table>
        <thead>
            <tr>
                <th>Huésped</th>
                <th>Alojamiento</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th>Estado</th>
                <th>Importe</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-reservas">
            {% for reserva in reservas %}
                <tr>
                    <td>{{ reserva.nombre_huesped }}</td>
                    <td>{{ reserva.nombre_alojamiento }}</td>
                    <td>{{ reserva.fecha_entrada|date("d/m/Y") }}</td>
                    <td>{{ reserva.fecha_salida|date("d/m/Y") }}</td>
                    <td>{{ reserva.estado|capitalize }}</td>
                    <td>{{ reserva.importe|number_format(2, ',', '.') }} €</td>
                    <td>
                        <a href="/reserva/{{ reserva.id }}">Ver</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">No hay reservas que mostrar.</td>
                </tr>
            {% endfor %}

        </tbody>
    </table>
{% endblock %}