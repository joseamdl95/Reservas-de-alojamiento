    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Reservas de Alojamiento{% endblock %}</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>Reservas de Alojamiento</h1>
